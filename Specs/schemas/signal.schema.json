{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://confluence.bilal/schemas/signal.schema.json",
  "title": "TradeSignal",
  "description": "Deterministic signal output with code-owned levels, confidence calibration, and behavioral psychology report.",
  "type": "object",
  "required": [
    "id",
    "fingerprint",
    "symbol",
    "displayName",
    "marketClass",
    "timeframe",
    "htfTimeframe",
    "category",
    "direction",
    "tier",
    "confidencePercent",
    "regime",
    "riskState",
    "killzone",
    "htfBias",
    "generatedAtEpochSeconds",
    "barCloseEpochSeconds",
    "alignedStrategies",
    "psychologyReport",
    "dataProvider"
  ],
  "properties": {
    "id": {
      "type": "string"
    },
    "fingerprint": {
      "type": "string"
    },
    "symbol": {
      "type": "string"
    },
    "displayName": {
      "type": "string"
    },
    "marketClass": {
      "enum": [
        "crypto",
        "forex",
        "metals",
        "indices",
        "stocks"
      ]
    },
    "timeframe": {
      "enum": [
        "15m",
        "30m",
        "1h",
        "4h",
        "1d"
      ]
    },
    "htfTimeframe": {
      "enum": [
        "15m",
        "30m",
        "1h",
        "4h",
        "1d"
      ]
    },
    "category": {
      "enum": [
        "STRONG_SIGNAL",
        "WEAK_SIGNAL",
        "TRAP_ALERT"
      ]
    },
    "direction": {
      "enum": [
        "long",
        "short",
        "neutral"
      ]
    },
    "trapDirection": {
      "type": [
        "string",
        "null"
      ],
      "enum": [
        "bullTrap",
        "bearTrap",
        null
      ]
    },
    "tier": {
      "enum": [
        "aPlusInstitutional",
        "highConviction",
        "aligned",
        "weakFiltered",
        "trapWarning"
      ]
    },
    "confidencePercent": {
      "type": "number",
      "minimum": 0,
      "maximum": 92
    },
    "regime": {
      "enum": [
        "trending",
        "meanReverting",
        "highVol",
        "crisis"
      ]
    },
    "riskState": {
      "enum": [
        "safe",
        "near_limit",
        "reduce"
      ]
    },
    "killzone": {
      "enum": [
        "london",
        "newYork",
        "londonClose",
        "asian",
        "offSession"
      ]
    },
    "htfBias": {
      "enum": [
        "long",
        "short",
        "neutral"
      ]
    },
    "generatedAtEpochSeconds": {
      "type": "number"
    },
    "barCloseEpochSeconds": {
      "type": "number"
    },
    "levels": {
      "type": [
        "object",
        "null"
      ],
      "required": [
        "entryLow",
        "entryHigh",
        "entryMid",
        "stopLoss",
        "tp1",
        "tp2",
        "riskPercent",
        "reward1Percent",
        "reward2Percent",
        "riskRewardRatio",
        "tp2RiskRewardRatio",
        "isTP2Enabled"
      ],
      "properties": {
        "entryLow": {
          "type": "number"
        },
        "entryHigh": {
          "type": "number"
        },
        "entryMid": {
          "type": "number"
        },
        "stopLoss": {
          "type": "number"
        },
        "tp1": {
          "type": "number"
        },
        "tp2": {
          "type": "number"
        },
        "riskPercent": {
          "type": "number"
        },
        "reward1Percent": {
          "type": "number"
        },
        "reward2Percent": {
          "type": "number"
        },
        "riskRewardRatio": {
          "type": "number"
        },
        "tp2RiskRewardRatio": {
          "type": "number"
        },
        "isTP2Enabled": {
          "type": "boolean"
        }
      }
    },
    "alignedStrategies": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "name",
          "group",
          "direction",
          "weight",
          "historicalWinRate",
          "detail"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "group": {
            "enum": [
              "ictSmc",
              "candlestick",
              "trendMomentum",
              "behavioralTrap",
              "macroCatalyst"
            ]
          },
          "direction": {
            "enum": [
              "long",
              "short",
              "neutral"
            ]
          },
          "weight": {
            "type": "number"
          },
          "historicalWinRate": {
            "type": "number"
          },
          "detail": {
            "type": "string"
          }
        }
      }
    },
    "rejectionReasons": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "psychologyReport": {
      "type": "object",
      "required": [
        "signalCategory",
        "proDirection",
        "retailCrowdDirection",
        "provenanceBadge",
        "whatHappened",
        "beginnerPsychology",
        "proPsychology",
        "behavioralBadges",
        "evidence"
      ],
      "properties": {
        "signalCategory": {
          "enum": [
            "STRONG_SIGNAL",
            "WEAK_SIGNAL",
            "TRAP_ALERT"
          ]
        },
        "proDirection": {
          "enum": [
            "long",
            "short",
            "neutral"
          ]
        },
        "retailCrowdDirection": {
          "enum": [
            "long",
            "short",
            "neutral"
          ]
        },
        "provenanceBadge": {
          "type": "string"
        },
        "whatHappened": {
          "type": "string"
        },
        "beginnerPsychology": {
          "type": "string"
        },
        "proPsychology": {
          "type": "string"
        },
        "behavioralBadges": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "evidence": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "badge",
              "fact",
              "proBias",
              "retailBias"
            ],
            "properties": {
              "badge": {
                "type": "string"
              },
              "fact": {
                "type": "string"
              },
              "proBias": {
                "enum": [
                  "long",
                  "short",
                  "neutral"
                ]
              },
              "retailBias": {
                "enum": [
                  "long",
                  "short",
                  "neutral"
                ]
              }
            }
          }
        },
        "macroPositioningDirection": {
          "type": [
            "string",
            "null"
          ],
          "enum": [
            "long",
            "short",
            "neutral",
            null
          ]
        },
        "macroPositioningLabel": {
          "type": [
            "string",
            "null"
          ]
        },
        "macroAlignsWithSetup": {
          "type": [
            "boolean",
            "null"
          ]
        }
      }
    },
    "preNewsBadge": {
      "type": [
        "string",
        "null"
      ]
    },
    "postNewsCatalystBadge": {
      "type": [
        "string",
        "null"
      ]
    },
    "overlays": {
      "type": "object"
    },
    "recentCandles": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "aiJudgment": {
      "type": [
        "object",
        "null"
      ]
    },
    "aiConfirmed": {
      "type": "boolean"
    },
    "dataProvider": {
      "type": "string"
    },
    "isMarketClosedSnapshot": {
      "type": "boolean"
    },
    "marketClosedReason": {
      "type": [
        "string",
        "null"
      ]
    },
    "strengthBreakdown": {
      "type": [
        "object",
        "null"
      ]
    },
    "calibratedProbability": {
      "type": [
        "number",
        "null"
      ]
    },
    "calibrationSampleCount": {
      "type": [
        "integer",
        "null"
      ]
    },
    "origin": {
      "enum": [
        "scanner",
        "news"
      ]
    },
    "matchedStrategyIDs": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "activeStrategyProfileKey": {
      "type": "string"
    },
    "orderFlowStatus": {
      "enum": [
        "aligned",
        "neutral",
        "conflicting",
        "off",
        "non_crypto",
        "unavailable"
      ]
    },
    "orderFlowSummary": {
      "type": [
        "object",
        "null"
      ]
    }
  }
}
